<?xml version="1.0" ?>
<!-- RECENTRED: origin moved to the footprint centre on the base
     plane, so a spawn pose addresses the visible object and a
     z-rotation spins it about its own axis. Offset applied to
     visual, collision and inertial poses: 0.027001 0.005207 0.000503
     Yaw-safe radius about this origin: 0.0983 m -->
<sdf version='1.8'>
  <model name='ycb_031_spoon'>
    <link name='body'>
      <inertial>
        <mass>0.03</mass>
        <pose>0.00894508309 -0.00495356509 0.0105515925 0 0 0</pose>
        <inertia>
          <ixx>1.42613671184e-05</ixx>
          <ixy>3.51581177665e-05</ixy>
          <ixz>2.98776248622e-06</ixz>
          <iyy>9.87797131272e-05</iyy>
          <iyz>-1.04466163266e-06</iyz>
          <izz>0.000112109594868</izz>
        </inertia>
      </inertial>
      <visual name='ycb_031_spoon_visual'>
        <pose>0.027001 0.005207 0.000503 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://ycb_031_spoon/meshes/textured.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name='ycb_031_spoon_collision'>
        <pose>0.027001 0.005207 0.000503 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://ycb_031_spoon/meshes/nontextured.stl</uri>
          </mesh>
        </geometry>
        <max_contacts>10</max_contacts>
        <surface>
          <contact>
            <ode>
              <kp>1e15</kp>
              <kd>1e13</kd>
            </ode>
          </contact>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
