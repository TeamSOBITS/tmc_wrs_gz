  <model name='ycb_056_tennis_ball'>
    <link name='body'>
      <inertial>
        <mass>0.058</mass>
        <pose>-5.76026374e-06 0.000107573618 0.0328746205 0 0 0</pose>
        <inertia>
          <ixx>2.58584279109e-05</ixx>
          <ixy>1.89792860915e-10</ixy>
          <ixz>-5.62637608871e-08</ixz>
          <iyy>2.58462737538e-05</iyy>
          <iyz>-2.61472881057e-08</iyz>
          <izz>2.59187047722e-05</izz>
        </inertia>
      </inertial>
      <visual name='ycb_056_tennis_ball_visual'>
        <pose>-0.008239 0.0443 -1.2e-05 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://ycb_056_tennis_ball/meshes/textured.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name='ycb_056_tennis_ball_collision'>
