  <model name='ycb_053_mini_soccer_ball'>
    <link name='body'>
      <inertial>
        <mass>0.123</mass>
        <pose>-0.000157591431 0.000852561801 0.0616175534 0 0 0</pose>
        <inertia>
          <ixx>0.00019528110826</ixx>
          <ixy>1.22782118378e-06</ixy>
          <ixz>2.08950715463e-06</ixz>
          <iyy>0.000195681378984</iyy>
          <iyz>4.26617823389e-06</iyz>
          <izz>0.000195587066226</izz>
        </inertia>
      </inertial>
      <visual name='ycb_053_mini_soccer_ball_visual'>
        <pose>0.005755 -0.010678 0.000302 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://ycb_053_mini_soccer_ball/meshes/textured.dae</uri>
          </mesh>
        </geometry>
      </visual>
