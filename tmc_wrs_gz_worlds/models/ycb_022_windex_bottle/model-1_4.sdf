<?xml version="1.0" ?>
<!-- RECENTRED: origin moved to the footprint centre on the base
     plane, so a spawn pose addresses the visible object and a
     z-rotation spins it about its own axis. Offset applied to
     visual, collision and inertial poses: 0.016022 -0.023376 -0.135082
     Yaw-safe radius about this origin: 0.1413 m
     measured in its resting (lying) attitude; cannot stand upright -->
<sdf version='1.8'>
  <model name='ycb_022_windex_bottle'>
    <link name='body'>
      <inertial>
        <mass>1.022</mass>
        <pose>0.0299645643 -0.014945956 -0.0327134613 0 0 0</pose>
        <inertia>
          <ixx>0.00498803796691</ixx>
          <ixy>-4.43347650441e-05</ixy>
          <ixz>1.07219881226e-05</ixz>
          <iyy>0.00485964808771</iyy>
          <iyz>0.000102701885388</iyz>
          <izz>0.000731589299807</izz>
        </inertia>
      </inertial>
      <visual name='ycb_022_windex_bottle_visual'>
        <pose>0.016022 -0.023376 -0.135082 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://ycb_022_windex_bottle/meshes/textured.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name='ycb_022_windex_bottle_collision'>
        <pose>0.016022 -0.023376 -0.135082 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://ycb_022_windex_bottle/meshes/nontextured.stl</uri>
          </mesh>
        </geometry>
        <max_contacts>10</max_contacts>
        <surface>
          <contact>
            <ode>
              <kp>1e15</kp>
              <kd>1e13</kd>
            </ode>
          </contact>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
