  <model name='ycb_008_pudding_box'>
    <link name='body'>
      <inertial>
        <mass>0.187</mass>
        <pose>0.00086864957 -0.000360117935 0.019011702 0 0 0</pose>
        <inertia>
          <ixx>0.000151722587612</ixx>
          <ixy>-2.74392307099e-05</ixy>
          <ixz>-3.63567015346e-06</ixz>
          <iyy>0.000189163897167</iyy>
          <iyz>-1.15177563596e-06</iyz>
          <izz>0.000301634652645</izz>
        </inertia>
      </inertial>
      <visual name='ycb_008_pudding_box_visual'>
        <pose>-0.000649 -0.019156 0.000354 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://ycb_008_pudding_box/meshes/textured.dae</uri>
          </mesh>
