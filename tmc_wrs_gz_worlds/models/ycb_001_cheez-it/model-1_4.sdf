  <model name='ycb_001_cheez-it'>
    <link name='body'>
      <inertial>
        <mass>2.93393821406</mass>
        <pose>-0.0017945578 0.000649945533 0.105349868 0 0 0</pose>
        <inertia>
          <ixx>0.017100285088</ixx>
          <ixy>-3.56548142137e-06</ixy>
          <ixz>0.000109124466445</ixz>
          <iyy>0.0120082426729</iyy>
          <iyz>3.89306936817e-05</iyz>
          <izz>0.00713499707215</izz>
        </inertia>
      </inertial>

      <visual name='ycb_001_cheez-it_visual'>
        <pose>0.013059 0.014855 0.003145 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://ycb_001_cheez-it/meshes/textured.dae</uri>
