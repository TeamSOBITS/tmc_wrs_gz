  <model name='ycb_025_mug'>
    <link name='body'>
      <inertial>
        <mass>0.118</mass>
        <pose>-0.00408260655 -0.000280037709 0.0274878523 0 0 0</pose>
        <inertia>
          <ixx>0.000101690301436</ixx>
          <ixy>6.42850178059e-07</ixy>
          <ixz>-2.90301007713e-06</ixz>
          <iyy>0.000115579347511</iyy>
          <iyz>-2.51001765473e-06</iyz>
          <izz>0.00014729214583</izz>
        </inertia>
      </inertial>
      <visual name='ycb_025_mug_visual'>
        <pose>0.014776 -0.016853 0.000589 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://ycb_025_mug/meshes/textured.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name='ycb_025_mug_collision'>
        <pose>0.014776 -0.016853 0.000589 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://ycb_025_mug/meshes/nontextured.stl</uri>
