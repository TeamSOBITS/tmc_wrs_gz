  <model name='ycb_002_sugar_box'>
    <link name='body'>
      <inertial>
        <mass>0.514</mass>
        <pose>-0.000267415537 -0.00044216313 0.085933814 0 0 0</pose>
        <inertia>
          <ixx>0.00162065429869</ixx>
          <ixy>-9.49129245602e-06</ixy>
          <ixz>4.81821825212e-05</ixz>
          <iyy>0.00135931207958</iyy>
          <iyz>-1.64061737271e-05</iyz>
          <izz>0.000408012196346</izz>
        </inertia>
      </inertial>
      <visual name='ycb_002_sugar_box_visual'>
        <pose>0.007431 0.016636 -9e-05 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://ycb_002_sugar_box/meshes/textured.dae</uri>
