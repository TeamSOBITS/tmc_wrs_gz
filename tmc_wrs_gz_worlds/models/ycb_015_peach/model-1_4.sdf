  <model name='ycb_015_peach'>
    <link name='body'>
      <inertial>
        <mass>0.033</mass>
        <pose>-0.000794325738 0.00115099716 0.0283916031 0 0 0</pose>
        <inertia>
          <ixx>1.22991776417e-05</ixx>
          <ixy>-5.54718403499e-07</ixy>
          <ixz>1.33134589292e-07</ixz>
          <iyy>1.19459549782e-05</iyy>
          <iyz>-1.60415392037e-07</iyz>
          <izz>1.27205747484e-05</izz>
        </inertia>
      </inertial>
      <visual name='ycb_015_peach_visual'>
        <pose>0.014253 -0.005633 0.000132 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://ycb_015_peach/meshes/textured.dae</uri>
